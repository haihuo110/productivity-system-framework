{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dachen.example/schemas/sim-package-v1.json",
  "title":"Dachen TVET Simulation Package v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","contract_version","verification_status","open_issues","simulation","tracking_chain"],
  "properties":{
    "schema_version":{"const":"sim-package-v1"},
    "contract_version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "verification_status":{"enum":["draft","draft-validated","in-review","verified","rejected","deprecated"]},
    "open_issues":{"type":"array","items":{"type":"string"}},
    "simulation":{"$ref":"#/$defs/simulation"},
    "tracking_chain":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^JOB-[A-Z0-9-]+ -> COMP-[A-Z0-9-]+ -> MOD-[A-Z0-9-]+ -> SCN-[A-Z0-9-]+ -> WO-[A-Z0-9-]+ -> SIM-[A-Z0-9-]+ -> AUDIT-[A-Z0-9-]+$"}}
  },
  "$defs":{
    "simulation":{"type":"object","additionalProperties":false,"required":["id","work_order_id","title","runtime","vc_assets","robot_teach_pendant","checkpoints","hardware_mapping","validation"],"properties":{
      "id":{"type":"string","pattern":"^SIM-[A-Z0-9-]+$"},"work_order_id":{"type":"string","pattern":"^WO-[A-Z0-9-]+$"},"title":{"type":"string"},"runtime":{"type":"object","additionalProperties":false,"required":["platform","version","isolation_mode"],"properties":{"platform":{"type":"string"},"version":{"type":"string"},"isolation_mode":{"enum":["offline","sandbox","hardware-in-the-loop"]}}},
      "vc_assets":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["asset_id","source_uri","version","coordinate_system","mapping_role"],"properties":{"asset_id":{"type":"string"},"source_uri":{"type":"string"},"version":{"type":"string"},"coordinate_system":{"type":"string"},"mapping_role":{"type":"string"},"collision_model":{"type":"string"}}}},
      "robot_teach_pendant":{"type":"object","additionalProperties":false,"required":["robot_model","script_language","program","interaction_events"],"properties":{"robot_model":{"type":"string"},"script_language":{"type":"string"},"program":{"type":"string"},"interaction_events":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["event","trigger","expected_state"],"properties":{"event":{"type":"string"},"trigger":{"type":"string"},"expected_state":{"type":"string"}}}}}},
      "checkpoints":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","after_step","saved_state","resume_policy"],"properties":{"id":{"type":"string","pattern":"^SIM-CP-[A-Z0-9-]+$"},"after_step":{"type":"integer","minimum":1},"saved_state":{"type":"array","items":{"type":"string"}},"resume_policy":{"type":"string"}}}},
      "hardware_mapping":{"type":"object","additionalProperties":false,"required":["plc_io","teach_coordinates"],"properties":{"plc_io":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["sim_signal","plc_address","direction","data_type","safe_default"],"properties":{"sim_signal":{"type":"string"},"plc_address":{"type":"string"},"direction":{"enum":["input","output"]},"data_type":{"type":"string"},"polarity":{"type":"string"},"safe_default":{"type":"string"}}}},"teach_coordinates":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","frame","units","values","tolerance"],"properties":{"name":{"type":"string"},"frame":{"type":"string"},"units":{"type":"string"},"values":{"type":"array","items":{"type":"number"}},"tolerance":{"type":"string"}}}}}},
      "validation":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["test","result","evidence"],"properties":{"test":{"type":"string"},"result":{"enum":["pass","fail","blocked"]},"evidence":{"type":"string"}}}}
    }}
  }
}