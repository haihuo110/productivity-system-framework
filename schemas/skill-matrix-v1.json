{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dachen.example/schemas/skill-matrix-v1.json",
  "title": "Dachen TVET Skill Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "verification_status", "open_issues", "job", "competencies", "tracking_chain"],
  "properties": {
    "schema_version": {"const": "skill-matrix-v1"},
    "contract_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "verification_status": {"enum": ["draft", "draft-validated", "in-review", "verified", "deprecated"]},
    "open_issues": {"type": "array", "items": {"type": "string"}},
    "job": {"$ref": "#/$defs/job"},
    "competencies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/competency"}},
    "tracking_chain": {"type": "array", "items": {"type": "string", "pattern": "^JOB-[A-Z0-9-]+ -> COMP-[A-Z0-9-]+ -> MOD-[A-Z0-9-]+ -> SCN-[A-Z0-9-]+ -> WO-[A-Z0-9-]+$"}}
  },
  "$defs": {
    "source": {"type": "object", "additionalProperties": false, "required": ["source_id", "title", "version", "locator"], "properties": {"source_id": {"type": "string"}, "title": {"type": "string"}, "version": {"type": "string"}, "locator": {"type": "string"}, "evidence": {"type": "string"}}},
    "job": {"type": "object", "additionalProperties": false, "required": ["id", "title", "industry", "level", "responsibilities", "sources"], "properties": {"id": {"type": "string", "pattern": "^JOB-[A-Z0-9-]+$"}, "title": {"type": "string", "minLength": 1}, "industry": {"type": "string"}, "level": {"type": "string"}, "responsibilities": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}}},
    "competency": {"type": "object", "additionalProperties": false, "required": ["id", "job_id", "name", "domain", "level", "observable_behaviors", "evidence_requirements", "safety_critical", "module_ids", "sources"], "properties": {"id": {"type": "string", "pattern": "^COMP-[A-Z0-9-]+$"}, "job_id": {"type": "string", "pattern": "^JOB-[A-Z0-9-]+$"}, "name": {"type": "string"}, "domain": {"enum": ["knowledge", "skill", "attitude", "safety", "quality"]}, "level": {"type": "integer", "minimum": 1, "maximum": 8}, "observable_behaviors": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "prerequisite_ids": {"type": "array", "items": {"type": "string", "pattern": "^COMP-[A-Z0-9-]+$"}}, "tools": {"type": "array", "items": {"type": "string"}}, "safety_critical": {"type": "boolean"}, "module_ids": {"type": "array", "items": {"type": "string", "pattern": "^MOD-[A-Z0-9-]+$"}}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}}}
  }
}
